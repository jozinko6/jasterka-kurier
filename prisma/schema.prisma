generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───

enum UserRole {
  ADMIN
  KITCHEN
  COURIER
  CUSTOMER
  OWNER
}

enum OrderStatus {
  NEW
  ACCEPTED
  IN_KITCHEN
  PREPARING
  READY
  WAITING_FOR_COURIER
  ASSIGNED_TO_COURIER
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderType {
  DELIVERY
  PICKUP
  SCHEDULED_DELIVERY
  SCHEDULED_PICKUP
}

enum PaymentMethod {
  CASH
  CARD_ON_DELIVERY
  CARD_ON_PICKUP
  ONLINE_CARD
}

enum CourierStatus {
  OFFLINE
  AVAILABLE
  ASSIGNED
  PICKING_UP
  DELIVERING
  BREAK
}

enum DeliveryAssignmentStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum VehicleType {
  BICYCLE
  SCOOTER
  CAR
}

enum MenuItemOptionType {
  SIZE
  EXTRA
  REMOVE
}

// ─── Models ───

model User {
  id                 String    @id @default(cuid())
  email              String?   @unique
  phone              String?   @unique
  passwordHash       String?   @map("password_hash")
  role               UserRole  @default(CUSTOMER)
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  customerProfile    Customer?
  courierProfile     Courier?
  orderStatusChanges OrderStatusHistory[]
  deliveryAssignments DeliveryAssignment[] @relation("AssignmentActor")
  kitchenEvents      KitchenEvent[]

  @@map("users")
}

model Customer {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  fullName         String   @map("full_name")
  defaultNote      String?  @map("default_note")
  marketingConsent Boolean  @default(false) @map("marketing_consent")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders           Order[]

  @@map("customers")
}

model Courier {
  id               String        @id @default(cuid())
  userId           String        @unique @map("user_id")
  displayName      String        @map("display_name")
  phone            String?
  vehicleType      VehicleType   @default(BICYCLE) @map("vehicle_type")
  status           CourierStatus @default(OFFLINE)
  isActive         Boolean       @default(true) @map("is_active")
  currentLatitude  Float?        @map("current_latitude")
  currentLongitude Float?        @map("current_longitude")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments      DeliveryAssignment[]
  earnings         CourierEarning[]
  activeOrderCount Int              @default(0) @map("active_order_count")

  @@map("couriers")
}

model MenuCategory {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  isDailyMenu Boolean    @default(false) @map("is_daily_menu")
  imageUrl    String?    @map("image_url")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  menuItems   MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id                     String     @id @default(cuid())
  categoryId             String     @map("category_id")
  slug                   String     @unique
  name                   String
  description            String?
  basePrice              Decimal    @db.Decimal(10, 2) @map("base_price")
  imageUrl               String?    @map("image_url")
  isActive               Boolean    @default(true) @map("is_active")
  isFeatured             Boolean    @default(false) @map("is_featured")
  isAvailable            Boolean    @default(true) @map("is_available")
  preparationTimeMinutes Int?       @map("preparation_time_minutes")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  category               MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  options                MenuItemOption[]
  orderItems             OrderItem[]

  @@map("menu_items")
}

model MenuItemOption {
  id          String             @id @default(cuid())
  menuItemId  String             @map("menu_item_id")
  optionGroup String             @map("option_group")
  optionType  MenuItemOptionType @map("option_type")
  name        String
  priceDelta  Decimal            @default(0) @db.Decimal(10, 2) @map("price_delta")
  isDefault   Boolean            @default(false) @map("is_default")
  isRequired  Boolean            @default(false) @map("is_required")
  sortOrder   Int                @default(0) @map("sort_order")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  menuItem    MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("menu_item_options")
}

model Order {
  id                   String        @id @default(cuid())
  orderNumber          String        @unique @map("order_number")
  customerId           String?       @map("customer_id")
  status               OrderStatus   @default(NEW)
  orderType            OrderType     @default(DELIVERY) @map("order_type")
  paymentMethod        PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus        String        @default("PENDING") @map("payment_status")
  customerName         String        @map("customer_name")
  customerPhone        String        @map("customer_phone")
  customerEmail        String?       @map("customer_email")
  deliveryZoneId       String?       @map("delivery_zone_id")
  deliveryAddressLine1 String?       @map("delivery_address_line1")
  deliveryAddressLine2 String?       @map("delivery_address_line2")
  deliveryCity         String?       @map("delivery_city")
  deliveryNote         String?       @map("delivery_note")
  kitchenNote          String?       @map("kitchen_note")
  subtotalAmount       Decimal       @db.Decimal(10, 2) @map("subtotal_amount")
  deliveryFee          Decimal       @default(0) @db.Decimal(10, 2) @map("delivery_fee")
  totalAmount          Decimal       @db.Decimal(10, 2) @map("total_amount")
  scheduledFor         DateTime?     @map("scheduled_for")
  acceptedAt           DateTime?     @map("accepted_at")
  readyAt              DateTime?     @map("ready_at")
  pickedUpAt           DateTime?     @map("picked_up_at")
  deliveredAt          DateTime?     @map("delivered_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  customer             Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryZone         DeliveryZone?     @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  assignments          DeliveryAssignment[]
  earnings             CourierEarning[]
  kitchenEvents        KitchenEvent[]

  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                   String   @id @default(cuid())
  orderId              String   @map("order_id")
  menuItemId           String?  @map("menu_item_id")
  menuItemNameSnapshot String   @map("menu_item_name_snapshot")
  quantity             Int
  basePriceSnapshot    Decimal  @db.Decimal(10, 2) @map("base_price_snapshot")
  unitTotalSnapshot    Decimal  @db.Decimal(10, 2) @map("unit_total_snapshot")
  lineTotal            Decimal  @db.Decimal(10, 2) @map("line_total")
  selectedSize         String?  @map("selected_size")
  selectedOptions      String?  @map("selected_options")
  kitchenNote          String?  @map("kitchen_note")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem             MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model OrderStatusHistory {
  id              String      @id @default(cuid())
  orderId         String      @map("order_id")
  status          OrderStatus
  changedByUserId String?     @map("changed_by_user_id")
  reason          String?
  createdAt       DateTime    @default(now()) @map("created_at")

  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser   User?       @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_status_history")
}

model DeliveryZone {
  id                       String   @id @default(cuid())
  name                     String   @unique
  deliveryFee              Decimal  @default(0) @db.Decimal(10, 2) @map("delivery_fee")
  minimumOrderAmount       Decimal  @default(0) @db.Decimal(10, 2) @map("minimum_order_amount")
  estimatedDeliveryMinutes Int      @map("estimated_delivery_minutes")
  allowedVehicleTypes      String   @default("BICYCLE,SCOOTER,CAR") @map("allowed_vehicle_types")
  isActive                 Boolean  @default(true) @map("is_active")
  priority                 Int      @default(0)
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  orders      Order[]
  assignments DeliveryAssignment[]
  earnings    CourierEarning[]

  @@map("delivery_zones")
}

model DeliveryAssignment {
  id               String                   @id @default(cuid())
  orderId          String                   @map("order_id")
  courierId        String                   @map("courier_id")
  zoneId           String?                  @map("zone_id")
  status           DeliveryAssignmentStatus @default(PENDING)
  assignedByUserId String?                  @map("assigned_by_user_id")
  assignedAt       DateTime                 @default(now()) @map("assigned_at")
  acceptedAt       DateTime?                @map("accepted_at")
  pickedUpAt       DateTime?                @map("picked_up_at")
  deliveredAt      DateTime?                @map("delivered_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  order            Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier          Courier                  @relation(fields: [courierId], references: [id], onDelete: Restrict)
  zone             DeliveryZone?            @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  assignedByUser   User?                    @relation("AssignmentActor", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([courierId])
  @@index([orderId])
  @@map("delivery_assignments")
}

model CourierEarning {
  id                     String   @id @default(cuid())
  courierId              String   @map("courier_id")
  orderId                String   @unique @map("order_id")
  zoneId                 String?  @map("zone_id")
  baseAmount             Decimal  @db.Decimal(10, 2) @map("base_amount")
  zoneBonusAmount        Decimal  @default(0) @db.Decimal(10, 2) @map("zone_bonus_amount")
  manualAdjustmentAmount Decimal  @default(0) @db.Decimal(10, 2) @map("manual_adjustment_amount")
  totalAmount            Decimal  @db.Decimal(10, 2) @map("total_amount")
  earningDate            DateTime @map("earning_date")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  courier                Courier       @relation(fields: [courierId], references: [id], onDelete: Cascade)
  order                  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  zone                   DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@map("courier_earnings")
}

model KitchenEvent {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  eventType       String   @map("event_type")
  note            String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@map("kitchen_events")
}

model RestaurantSettings {
  id                  String   @id @default(cuid())
  deliveryEnabled     Boolean  @default(true) @map("delivery_enabled")
  pickupEnabled       Boolean  @default(true) @map("pickup_enabled")
  isOpen              Boolean  @default(true) @map("is_open")
  customerMessage     String?  @map("customer_message")
  averagePrepMinutes  Int      @default(30) @map("average_prep_minutes")
  minimumOrderAmount  Decimal  @default(0) @db.Decimal(10, 2) @map("minimum_order_amount")
  storePhone          String?  @map("store_phone")
  storeAddress        String?  @map("store_address")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("restaurant_settings")
}

model OpeningHours {
  id         String   @id @default(cuid())
  dayOfWeek  Int      @map("day_of_week")
  openTime   String?  @map("open_time")
  closeTime  String?  @map("close_time")
  isClosed   Boolean  @default(false) @map("is_closed")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([dayOfWeek])
  @@map("opening_hours")
}
